<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>jsanca</groupId>
    <artifactId>dotcms-content-model-inspector</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>bundle</packaging>

    <name>dotcms-content-model-inspector</name>
    <description>dotCMS REST endpoint OSGi plugin.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <dotcms-core.version>26.03.27-01</dotcms-core.version>
        
        <maven-bundle-plugin.version>5.1.9</maven-bundle-plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>dotcms-repo</id>
            <url>https://artifactory.dotcms.cloud/artifactory/libs-release</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.dotcms</groupId>
            <artifactId>dotcms-core</artifactId>
            <version>${dotcms-core.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven-bundle-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-Vendor>dotCMS</Bundle-Vendor>
                        <Bundle-Name>dotcms-content-model-inspector</Bundle-Name>
                        <Bundle-SymbolicName>jsanca.dotcms-content-model-inspector</Bundle-SymbolicName>
                        <Bundle-Description>dotCMS REST endpoint OSGi plugin.</Bundle-Description>
                        <Bundle-DocURL>https://dotcms.com/</Bundle-DocURL>
                        <Bundle-Activator>jsanca.dotcms.inspector.plugin.rest.Activator</Bundle-Activator>

                        <Private-Package>jsanca.dotcms.inspector.plugin.*</Private-Package>
                        <Export-Package>!jsanca.dotcms.inspector.plugin.*</Export-Package>
                        <Import-Package>!jsanca.dotcms.inspector.plugin.*,*</Import-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- mvn clean verify -Pdeploy-local-dotcms \
  -Ddotcms.felix.upload.dir=/otra/ruta/dotcms-felix/upload -->
    <profiles>
        <profile>
            <id>deploy-local-dotcms</id>

            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-bundle-to-dotcms-felix-upload</id>
                                <phase>verify</phase>
                                <configuration>
                                    <target>
                                        <fail unless="dotcms.felix.upload.dir"
                                              message="Missing required property: dotcms.felix.upload.dir. Example: mvn clean verify -Pdeploy-local-dotcms -Ddotcms.felix.upload.dir=/path/to/dotcms-felix/upload" />

                                        <echo message="Deploying OSGi bundle to dotCMS Felix upload directory:" />
                                        <echo message="${dotcms.felix.upload.dir}" />

                                        <mkdir dir="${dotcms.felix.upload.dir}" />

                                        <delete
                                                file="${dotcms.felix.upload.dir}/${project.build.finalName}.jar"
                                                quiet="true" />

                                        <copy
                                                file="${project.build.directory}/${project.build.finalName}.jar"
                                                todir="${dotcms.felix.upload.dir}"
                                                overwrite="true" />

                                        <echo message="Bundle deployed: ${project.build.finalName}.jar" />
                                    </target>
                                </configuration>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>